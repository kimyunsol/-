function setup() {
  createCanvas(300, 300);
  background(0); // 검정색 배경

  // 1. 선(line)과 색상(stroke, RGB): 밤하늘 유성우
  stroke(255, 0, 0);
  line(0, 0, 300, 200);

  stroke(0, 0, 255);
  line(300, 0, 0, 200);

  // 2. 점(point)과 굵기(strokeWeight): 별
  stroke(255, 0, 0);
  strokeWeight(5);
  point(150, 120);
  point(150, 180);

  // 3. 사용자 정의 도형(beginShape~endShape, CLOSE, vertex): 산 모양
  fill(255, 255, 0);
  beginShape();
  vertex(50, 50);
  vertex(250, 50);
  vertex(250, 250);
  vertex(150, 250);
  vertex(150, 150);
  vertex(50, 150);
  endShape(CLOSE);

  // 4. 원호(arc, 라디안 PI 사용): 달 표현
  fill(255);
  arc(100, 100, 80, 80, 0, PI/2);

  // 5. 원(ellipse)과 사각형(rect): 건물 및 구조물
  ellipse(150, 150, 120, 80);
  rect(150, 150, 120, 80);

  // 6. 문자열(text, textSize): 제목 표기
  fill(0, 255, 0);
  textSize(30);
  text('Hello, p5.js!', 70, 100);
}
